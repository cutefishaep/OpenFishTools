<?xml version="1.0" encoding="UTF-8"?>
<installer-gui-script minSpecVersion="2">

    <title>OpenFishTools</title>
    <organization>com.cutefish</organization>
    <domains enable_localSystem="true" enable_currentUserHome="false" />
    <options customize="allow" require-scripts="true" rootVolumeOnly="true" />

    <welcome    file="welcome.html"    mime-type="text/html" />
    <license    file="license.html"    mime-type="text/html" />
    <conclusion file="conclusion.html" mime-type="text/html" />

    <volume-check>
        <allowed-os-versions>
            <os-version min="10.14" />
        </allowed-os-versions>
    </volume-check>

    <pkg-ref id="com.cutefish.tools.pkg">OpenFishTools_component.pkg</pkg-ref>
    <pkg-ref id="com.cutefish.tools.uninstall.pkg">OpenFishTools_uninstall_component.pkg</pkg-ref>

    <choices-outline>
        <line choice="choice_install" />
        <line choice="choice_uninstall" />
    </choices-outline>

    <choice
        id="choice_install"
        title="Install OpenFishTools"
        description="Installs the OpenFishTools CEP extension and enables PlayerDebugMode."
        start_selected="true"
        start_enabled="true">
        <pkg-ref id="com.cutefish.tools.pkg" />
    </choice>

    <choice
        id="choice_uninstall"
        title="Uninstall OpenFishTools"
        description="Removes OpenFishTools extension files from your system."
        start_selected="false"
        start_enabled="true">
        <pkg-ref id="com.cutefish.tools.uninstall.pkg" />
    </choice>

</installer-gui-script>
